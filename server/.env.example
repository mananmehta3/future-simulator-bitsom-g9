# Local dev: a file path relative to where the server process is started
# (server/), i.e. server/prisma/dev.db. NOTE: this is NOT relative to
# schema.prisma like plain Prisma SQLite — it's resolved by the libSQL client.
#
# Production (Turso): "libsql://your-db-name-yourusername.turso.io"
DATABASE_URL="file:./prisma/dev.db"

# Required only when DATABASE_URL is a libsql:// (Turso) URL — leave unset for
# local file-based SQLite. Get one via `turso db tokens create <db-name>`.
# DATABASE_AUTH_TOKEN="eyJ..."

# Which engine generates simulations:
#   "mock"   - free, offline, template-based (default, zero setup)
#   "gemini" - free real AI via Google's Gemini free tier
#   "claude" - paid, highest-quality AI via the Anthropic API
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini. Get one free at aistudio.google.com.
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-flash-latest"

# Required only when AI_PROVIDER=claude. Get one at console.anthropic.com.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
