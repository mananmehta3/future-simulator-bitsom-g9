DATABASE_URL="file:./dev.db"

# Which engine generates simulations:
#   "mock"   - free, offline, template-based (default, zero setup)
#   "gemini" - free real AI via Google's Gemini free tier
#   "claude" - paid, highest-quality AI via the Anthropic API
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini. Get one free at aistudio.google.com.
GEMINI_API_KEY="AIza..."
GEMINI_MODEL="gemini-flash-latest"

# Required only when AI_PROVIDER=claude. Get one at console.anthropic.com.
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
